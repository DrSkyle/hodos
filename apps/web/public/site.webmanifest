{
  "id": "/",
  "name": "Hodos — the road maps itself",
  "short_name": "Hodos",
  "description": "A live map of potholes, rough stretches and speed bumps, built by the phones already driving. Free, everywhere.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#faf8f2",
  "background_color": "#faf8f2",
  "lang": "en",
  "dir": "ltr",
  "categories": ["navigation", "travel", "utilities"],
  "icons": [
    {
